+#[tokio::test]
+async fn existing_wifi_start_uses_transition_without_legacy_wifi_sharing() {
+    let (accessory, mut phone) = pair();
+    let (tx, mut rx) = mpsc::channel(32);
+    let mut cp = cp_config();
+    cp.security_type = SecurityType::Wpa3Transition;
+    cp.reuse_connected_wifi = true;
+    cp.wireless_handoff = livi_runtime::wireless_handoff::WirelessHandoff::new("192.0.2.10", "fe80::10");
+    let handle = tokio::spawn(run_accessory(accessory, MockAuth { cert: vec![1] }, identity(), cp, tx, VehicleFeed::quiet()));
+    phone.send(StartIdentification {}.encode()).await.unwrap();
+    let ident = IdentificationInformation::decode(&phone.expect(0x1D01).await).unwrap();
+    assert!(!ident.messages_sent_by_accessory.chunks_exact(2).any(|m| m == [0x57,0x03]));
+    assert!(!ident.messages_received_from_accessory.chunks_exact(2).any(|m| m == [0x57,0x02]));
+    phone.send(IdentificationAccepted {}.encode()).await.unwrap();
+    assert_eq!(rx.recv().await,Some(BringupEvent::Identified));
+    phone.send(AuthenticationSucceeded {}.encode()).await.unwrap();
+    assert_eq!(rx.recv().await,Some(BringupEvent::Authenticated));
+    for expected in [0x5000,0x5200,0xAE00,0x4157,0x4154] { phone.expect(expected).await; }
+    assert_eq!(rx.recv().await,Some(BringupEvent::Subscribed));
+    phone.send(iap2_csm::messages::wifi::RequestAccessoryWiFiConfigurationInformation {}.encode()).await.unwrap();
+    phone.send(CarPlayAvailability {
+        wired_attributes:None,
+        wireless_attributes:Some(CarPlayAvailabilityWirelessAttributes { available:Some(true),bluetooth_transport_identifier:None }),
+    }.encode()).await.unwrap();
+    let frame = tokio::time::timeout(std::time::Duration::from_secs(1),phone.expect(0x4301)).await.unwrap();
+    let wireless = CarPlayStartSession::decode(&frame).unwrap().wireless_attributes.unwrap();
+    assert_eq!(wireless.wifi_ssid.as_deref(),Some("LIVI"));
+    assert_eq!(wireless.passphrase.as_deref(),Some("12345678"));
+    assert_eq!(wireless.channel,Some(36));
+    assert_eq!(wireless.ip_address,vec!["192.0.2.10"]);
+    assert_eq!(wireless.security_type,Some(3));
+    drop(phone);handle.await.unwrap();
 }

